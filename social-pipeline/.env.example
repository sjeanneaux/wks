# ---- AI (caption + blog generation) ----
# Anthropic API key used to turn the transcript into platform-specific captions and blog posts.
ANTHROPIC_API_KEY=sk-ant-...
# Model used for text generation. Defaults to a current Claude model if unset.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Zernio (multi-platform publishing) ----
# Bearer token from your Zernio account (https://zernio.com). Posts to all platforms in one call.
ZERNIO_API_KEY=
# Base URL — override only if Zernio changes it.
ZERNIO_BASE_URL=https://zernio.com/api

# Comma-separated target platforms. Supported by Zernio:
# instagram, tiktok, youtube, facebook, linkedin, google_business,
# twitter, pinterest, reddit, threads, bluesky, telegram, whatsapp, snapchat, discord
TARGET_PLATFORMS=instagram,tiktok,youtube,facebook,linkedin,google_business

# ---- Tella (recording source) ----
# Tella is NOT available as a CLI/MCP in this environment. The Tella adapter is a stub
# (src/tella/tella.ts). If you have a Tella export URL or local file + transcript, point to them:
TELLA_VIDEO_PATH=
TELLA_TRANSCRIPT_PATH=

# ---- Engagement (comment / DM auto-reply) ----
# Keyword -> link map used by the engagement bot. JSON object.
# Example: {"INFO":"https://example.com/lp","KURS":"https://example.com/kurs"}
ENGAGE_KEYWORD_LINKS={}
# Port for the webhook server that receives comment/DM events.
ENGAGE_WEBHOOK_PORT=8787
